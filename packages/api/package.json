{
  "name": "@ai-hub/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "for f in migrations/*.sql; do psql $DATABASE_URL -f \"$f\"; done",
    "seed:admin": "tsx seeds/create-admin.ts"
  },
  "dependencies": {
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "@aws-sdk/client-s3": "^3.712.0",
    "meilisearch": "^0.47.0",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "@ai-hub/shared": "*"
  }
}
