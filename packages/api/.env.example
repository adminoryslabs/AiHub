# Base de datos PostgreSQL
DATABASE_URL=postgresql://fcp_user:fcp_password@localhost:5432/aihub
DATABASE_URL_TEST=postgresql://fcp_user:fcp_password@localhost:5432/aihub_test

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-seguro-con-openssl-rand-hex-32
JWT_EXPIRES_IN=24h

# Admin inicial (usado solo en seed)
ADMIN_EMAIL=admin@aihub.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key
R2_SECRET_ACCESS_KEY=tu-secret-key
R2_BUCKET=aihub-images
R2_PUBLIC_URL=https://images.aihub.example.com

# Servidor
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# URL del sitio (para el sitemap)
NEXT_PUBLIC_SITE_URL=https://aihub.example.com
