# URL base de la API del AI Hub (incluye el prefijo /api/v1).
# Por defecto apunta a la NAS pública. Cámbiala si quieres probar contra una API local.
AIHUB_API_URL=https://api-aihub.oryslabs.com/api/v1

# Credenciales del usuario admin existente que el MCP usará para autenticarse.
# Debe tener los permisos editoriales necesarios (article.edit, article.review, article.publish).
AIHUB_EMAIL=tu-admin@oryslabs.com
AIHUB_PASSWORD=tu-password
